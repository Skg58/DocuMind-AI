# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Application
APP_NAME=DocuMind AI
DEBUG=false
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=15

# ML Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# Index Storage
FAISS_INDEX_DIR=data/faiss_index
BM25_INDEX_DIR=data/bm25_index

# Caching
CACHE_TTL=300
CACHE_MAX_SIZE=128

# Rate Limiting
RATE_LIMIT_RPM=30

# Stateless storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
